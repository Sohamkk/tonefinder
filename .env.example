# Copy to .env and fill in. Never commit .env.

FLASK_SECRET_KEY=change-me-to-a-long-random-string

# --- Photo analysis ---
# Leave every one of these blank and the app still works: it falls back to the
# offline reader, which needs no key, costs nothing and has no limit.
# For real scene understanding, get a FREE key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional second free option: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# Optional, paid: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Which readers to try, in order. 'local' never fails — keep it last.
ANALYZER_ORDER=gemini,openrouter,anthropic,local

# --- Database ---
# Blank = SQLite file next to app.py, which survives restarts on any host with
# a normal disk. On Vercel or another read-only host, set a Postgres URL here.
DATABASE_URL=

# --- Spotify (required for correct embedded players) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Payments (Razorpay) ---
# Both values must come from the SAME generated pair in
# Dashboard -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
