# Copy this file to .env and fill in real values. Never commit .env.

FLASK_SECRET_KEY=change-me-to-a-long-random-string

# --- Photo analysis (required) ---
# https://console.anthropic.com  ->  API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Spotify (required for the embedded player to find the right track) ---
# https://developer.spotify.com/dashboard -> Create app -> Client ID / Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
